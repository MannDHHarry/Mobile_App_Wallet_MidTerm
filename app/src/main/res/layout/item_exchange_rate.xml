<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/padding_standard"
    app:cardElevation="@dimen/card_elevation"
    app:cardCornerRadius="@dimen/card_corner_radius">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_large">

        <!-- Exchange Name Header -->
        <TextView
            android:id="@+id/tvExchangeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Binance"
            android:textColor="#5A3F61"
            android:textSize="@dimen/text_size_large"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/padding_standard" />

        <!-- Spot Price Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/padding_standard">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/spot_price"
                android:textColor="#757575"
                android:textSize="@dimen/text_size_small"
                android:layout_marginBottom="@dimen/padding_tiny" />

            <TextView
                android:id="@+id/tvSpotPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 USD = 0.00 MMK"
                android:textColor="#5A3F61"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                android:maxLines="2" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginVertical="@dimen/padding_small" />

        <!-- P2P Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/p2p_rates"
                android:textColor="#757575"
                android:textSize="@dimen/text_size_small"
                android:layout_marginBottom="@dimen/padding_small" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Buy Price -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/padding_small">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/buy"
                        android:textColor="#757575"
                        android:textSize="@dimen/text_size_tiny"
                        android:layout_marginBottom="@dimen/padding_tiny" />

                    <TextView
                        android:id="@+id/tvBuyPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00 MMK"
                        android:textColor="#4CAF50"
                        android:textSize="@dimen/text_size_normal"
                        android:textStyle="bold"
                        android:maxLines="2" />
                </LinearLayout>

                <!-- Sell Price -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/padding_small">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sell"
                        android:textColor="#757575"
                        android:textSize="@dimen/text_size_tiny"
                        android:layout_marginBottom="@dimen/padding_tiny" />

                    <TextView
                        android:id="@+id/tvSellPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00 MMK"
                        android:textColor="#F44336"
                        android:textSize="@dimen/text_size_normal"
                        android:textStyle="bold"
                        android:maxLines="2" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Last Updated -->
        <TextView
            android:id="@+id/tvLastUpdated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#9E9E9E"
            android:textSize="@dimen/text_size_tiny"
            android:layout_marginTop="@dimen/padding_small" />
    </LinearLayout>
</androidx.cardview.widget.CardView>

